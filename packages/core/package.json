{
  "name": "@flagshark/core-temp",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Temporary single-package home during M1; split in M2",
  "main": "./dist/cli.js",
  "bin": { "flagshark": "./bin/flagshark.mjs" },
  "files": ["dist/", "bin/", "action/"],
  "scripts": {
    "build": "bun run build:cli && bun run build:action",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.js --external:zod",
    "build:action": "esbuild action/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/action.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "p-limit": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "vitest": "^3.0.0"
  }
}

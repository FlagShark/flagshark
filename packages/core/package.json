{
  "name": "@flagshark/core",
  "version": "2.2.0",
  "type": "module",
  "description": "Detection engine for FlagShark — finds feature flag references across 13 languages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlagShark/flagshark.git",
    "directory": "packages/core"
  },
  "keywords": ["feature-flags", "polyglot-analysis", "static-analysis"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "bun run generate:queries && rm -rf dist && tsc -p tsconfig.build.json && bun run copy-queries",
    "copy-queries": "mkdir -p dist/detection/tree-sitter/queries && cp src/detection/tree-sitter/queries/*.scm dist/detection/tree-sitter/queries/",
    "generate:queries": "node scripts/generate-inline-queries.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^5.3.0",
    "p-limit": "^6.0.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.0",
    "web-tree-sitter": "^0.25.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
